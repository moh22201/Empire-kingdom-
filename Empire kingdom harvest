<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Empire Kingdom</title>

<script src="https://telegram.org/js/telegram-web-app.js"></script>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  background:#0d1117;
  color:#fff;
  font-family:Arial,sans-serif;
}

.game{
  max-width:720px;
  margin:auto;
  min-height:100vh;
  background:linear-gradient(#18232d,#0c1116);
}

/* HEADER */
header{
  padding:14px;
  background:#141c24;
  border-bottom:1px solid #3b4650;
  position:sticky;
  top:0;
  z-index:10;
}

.title{
  font-size:24px;
  font-weight:bold;
}

.subtitle{
  color:#9ba7b1;
  font-size:12px;
  margin-top:4px;
}

.resources{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:6px;
  margin-top:12px;
}

.resource{
  background:#202b34;
  border:1px solid #3b4650;
  border-radius:10px;
  padding:8px 3px;
  text-align:center;
  font-size:12px;
}

.resource b{
  display:block;
  font-size:16px;
  margin-top:3px;
}

/* CITY */
main{
  padding:12px;
}

.city{
  height:430px;
  position:relative;
  overflow:hidden;
  border-radius:18px;
  border:1px solid #59634f;

  background:
  radial-gradient(circle at 50% 50%,
  #687b52 0%,
  #526743 28%,
  #3c5137 55%,
  #29382c 100%);
}

/* أرضية */
.city:before{
  content:"";
  position:absolute;
  inset:0;

  background:
  linear-gradient(
    rgba(255,255,255,.025) 1px,
    transparent 1px
  ),
  linear-gradient(
    90deg,
    rgba(255,255,255,.025) 1px,
    transparent 1px
  );

  background-size:40px 40px;
}

/* BUILDINGS */
.building{
  position:absolute;
  width:120px;
  min-height:82px;

  padding:9px 5px;

  border-radius:12px;
  border:1px solid #a58c5d;

  background:
  linear-gradient(#655039,#30251c);

  box-shadow:0 6px 16px rgba(0,0,0,.55);

  text-align:center;
  font-weight:bold;

  cursor:pointer;
}

.building:active{
  transform:scale(.96);
}

.building small{
  display:block;
  color:#c6c0b4;
  font-weight:normal;
  margin-top:5px;
  font-size:11px;
}

.level{
  color:#e8c76a;
  font-size:11px;
  margin-top:5px;
}

/* POSITIONS */

.castle{
  width:155px;
  height:115px;
  left:50%;
  top:38%;
  transform:translate(-50%,-50%);
  background:linear-gradient(#755c3e,#33271d);
}

.farm{
  left:5%;
  top:7%;
}

.lumber{
  right:5%;
  top:7%;
}

.mine{
  left:5%;
  bottom:7%;
}

.barracks{
  right:5%;
  bottom:7%;
}

/* PANELS */
.panel{
  margin-top:12px;
  padding:13px;

  background:#182129;

  border:1px solid #35414a;
  border-radius:14px;
}

.panel h3{
  margin:0 0 10px;
  font-size:16px;
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.action{
  padding:12px 9px;

  border-radius:10px;
  border:1px solid #414d56;

  background:#222d36;
  color:#fff;

  font-weight:bold;
  text-align:left;
}

.action span{
  float:right;
  color:#e7c56a;
}

.status{
  color:#aeb8bf;
  font-size:12px;
  line-height:1.6;
}

.reset{
  width:100%;
  margin-top:10px;
  padding:10px;

  border:1px solid #573c3c;
  border-radius:10px;

  background:#271b1b;
  color:#d99a9a;
}
</style>
</head>


<body>

<div class="game">

<header>

  <div class="title">🏰 Empire Kingdom</div>

  <div class="subtitle">
    Build your kingdom • Gather resources • Upgrade your empire
  </div>

  <div class="resources">

    <div class="resource">
      🪵 Wood
      <b id="wood">100</b>
    </div>

    <div class="resource">
      🌾 Wheat
      <b id="wheat">100</b>
    </div>

    <div class="resource">
      ⛓️ Iron
      <b id="iron">50</b>
    </div>

    <div class="resource">
      🪙 Gold
      <b id="gold">100</b>
    </div>

  </div>

</header>


<main>

<!-- CITY -->

<section class="city">

  <div
    class="building castle"
    onclick="upgrade('castle')">

    🏰 Castle

    <small>
      Kingdom Center
    </small>

    <div
      class="level"
      id="castleLevel">
      Level 1
    </div>

  </div>


  <div
    class="building farm"
    onclick="upgrade('farm')">

    🌾 Farm

    <small>
      +2 Wheat / sec
    </small>

    <div
      class="level"
      id="farmLevel">
      Level 1
    </div>

  </div>


  <div
    class="building lumber"
    onclick="upgrade('lumber')">

    🪵 Lumber Mill

    <small>
      +2 Wood / sec
    </small>

    <div
      class="level"
      id="lumberLevel">
      Level 1
    </div>

  </div>


  <div
    class="building mine"
    onclick="upgrade('mine')">

    ⛓️ Iron Mine

    <small>
      +1 Iron / sec
    </small>

    <div
      class="level"
      id="mineLevel">
      Level 1
    </div>

  </div>


  <div
    class="building barracks"
    onclick="upgrade('barracks')">

    ⚔️ Barracks

    <small>
      Train Soldiers
    </small>

    <div
      class="level"
      id="barracksLevel">
      Level 1
    </div>

  </div>

</section>


<!-- ACTIONS -->

<section class="panel">

  <h3>🏗️ Kingdom Upgrades</h3>

  <div class="actions">

    <button
      class="action"
      onclick="upgrade('castle')">

      Upgrade Castle
      <span>⬆️</span>

    </button>


    <button
      class="action"
      onclick="upgrade('farm')">

      Upgrade Farm
      <span>⬆️</span>

    </button>


    <button
      class="action"
      onclick="upgrade('lumber')">

      Upgrade Lumber
      <span>⬆️</span>

    </button>


    <button
      class="action"
      onclick="upgrade('mine')">

      Upgrade Mine
      <span>⬆️</span>

    </button>

  </div>

</section>


<!-- STORAGE -->

<section class="panel">

  <h3>📦 Kingdom Status</h3>

  <div
    class="status"
    id="status">

    Resources are produced automatically every second.

  </div>

  <button
    class="reset"
    onclick="resetGame()">

    Reset Test Game

  </button>

</section>

</main>

</div>


<script>

/* TELEGRAM */

const tg = window.Telegram?.WebApp;

if(tg){
  tg.ready();
  tg.expand();
}


/* GAME DATA */

let game =
JSON.parse(
  localStorage.getItem("empireKingdomV1")
) || {

  wood:100,
  wheat:100,
  iron:50,
  gold:100,

  castle:1,
  farm:1,
  lumber:1,
  mine:1,
  barracks:1

};


/* SAVE */

function saveGame(){

  localStorage.setItem(
    "empireKingdomV1",
    JSON.stringify(game)
  );

}


/* DISPLAY */

function render(){

  document.getElementById("wood").textContent =
    Math.floor(game.wood);

  document.getElementById("wheat").textContent =
    Math.floor(game.wheat);

  document.getElementById("iron").textContent =
    Math.floor(game.iron);

  document.getElementById("gold").textContent =
    Math.floor(game.gold);


  document.getElementById("castleLevel").textContent =
    "Level " + game.castle;

  document.getElementById("farmLevel").textContent =
    "Level " + game.farm;

  document.getElementById("lumberLevel").textContent =
    "Level " + game.lumber;

  document.getElementById("mineLevel").textContent =
    "Level " + game.mine;

  document.getElementById("barracksLevel").textContent =
    "Level " + game.barracks;

}


/* UPGRADE */

function upgrade(type){

  const costs = {

    castle:[100,50,25],

    farm:[60,30,10],

    lumber:[60,30,10],

    mine:[80,40,15],

    barracks:[100,60,20]

  };


  const cost = costs[type];


  if(
    game.wood >= cost[0] &&
    game.wheat >= cost[1] &&
    game.iron >= cost[2]
  ){

    game.wood -= cost[0];

    game.wheat -= cost[1];

    game.iron -= cost[2];

    game[type]++;


    document.getElementById("status").textContent =
      "✅ " +
      type +
      " upgraded to Level " +
      game[type] +
      ".";


    saveGame();
    render();

  }else{

    document.getElementById("status").textContent =
      "❌ Not enough resources for this upgrade.";

  }

}


/* RESOURCE PRODUCTION */

setInterval(function(){

  game.wood += 2 * game.lumber;

  game.wheat += 2 * game.farm;

  game.iron += 1 * game.mine;

  game.gold += Math.floor(game.castle / 2);

  saveGame();

  render();

},1000);


/* RESET */

function resetGame(){

  if(!confirm("Reset the test game?")) return;

  localStorage.removeItem(
    "empireKingdomV1"
  );

  location.reload();

}


/* START */

render();

</script>

</body>
</html>
